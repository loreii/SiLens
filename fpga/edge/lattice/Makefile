# =============================================================================
# SiLens Edge Makefile - Lattice iCE40 UP5K Open-Source Toolchain
# =============================================================================
# Target: UPduino v3.1 (Lattice iCE40UP5K-SG48ITR)
# Toolchain: Yosys + nextpnr-ice40 + IceStorm
#
# Prerequisites (install via package manager or from source):
#   - yosys        (synthesis)
#   - nextpnr-ice40 (place and route)
#   - icestorm     (icepack, iceprog, icetime)
#
# Ubuntu/Debian:
#   sudo apt install yosys nextpnr-ice40 fpga-icestorm
#
# macOS (Homebrew):
#   brew install yosys nextpnr icestorm
#
# Build from source: https://github.com/YosysHQ/oss-cad-suite-build
#
# License: Apache 2.0
# =============================================================================

# =============================================================================
# Project Configuration
# =============================================================================

# Project name
PROJECT := silens_edge_ice40

# FPGA device and package
DEVICE := up5k
PACKAGE := sg48

# Pin constraint file
PCF := silens_edge_ice40.pcf

# Top-level module
TOP := silens_edge_ice40_wrapper

# =============================================================================
# Source Files
# =============================================================================

# RTL source directories (relative paths)
RTL_DIR := ../../../rtl
VARIANT_DIR := ../../../variants/silens-edge/openlane

# iCE40-specific wrapper
WRAPPER_SRC := silens_edge_ice40_wrapper.v

# Core RTL sources (filtered for synthesizable modules)
# Note: For iCE40, we use a heavily reduced "micro" configuration
# Most of the full SiLens RTL is too large - use stub/placeholder modules

VERILOG_SRCS := \
	$(WRAPPER_SRC)

# Additional includes for synthesis
VERILOG_INCS := \
	-I. \
	-I$(RTL_DIR) \
	-I$(RTL_DIR)/include

# =============================================================================
# Toolchain Configuration
# =============================================================================

# Synthesis (Yosys)
YOSYS := yosys
YOSYS_FLAGS := -q

# Place and Route (nextpnr)
NEXTPNR := nextpnr-ice40
NEXTPNR_FLAGS := \
	--$(DEVICE) \
	--package $(PACKAGE) \
	--freq 48 \
	--opt-timing \
	--timing-allow-fail

# Bitstream packing (icepack)
ICEPACK := icepack
ICEPACK_FLAGS :=

# Programming (iceprog)
ICEPROG := iceprog
ICEPROG_FLAGS :=

# Timing analysis (icetime)
ICETIME := icetime
ICETIME_FLAGS := -d $(DEVICE) -m -t

# =============================================================================
# Output Files
# =============================================================================

BUILD_DIR := build
JSON := $(BUILD_DIR)/$(PROJECT).json
ASC := $(BUILD_DIR)/$(PROJECT).asc
BIN := $(BUILD_DIR)/$(PROJECT).bin
RPT := $(BUILD_DIR)/$(PROJECT)_timing.rpt
LOG := $(BUILD_DIR)/$(PROJECT)_pnr.log
UTIL_RPT := $(BUILD_DIR)/$(PROJECT)_utilization.txt

# =============================================================================
# Yosys Synthesis Script
# =============================================================================

define YOSYS_SCRIPT
# SiLens Edge iCE40 UP5K Synthesis Script
# Auto-generated by Makefile

# Read Verilog sources
read_verilog -sv -DICE40 $(VERILOG_SRCS)

# Elaborate design
hierarchy -top $(TOP) -check

# Coarse-grain synthesis
proc
flatten
opt_expr
opt_clean
check
opt -nodffe -nosdff

# Technology mapping for iCE40
synth_ice40 -top $(TOP) -json $(JSON) -dsp -abc9

# Write statistics
stat
endef
export YOSYS_SCRIPT

# =============================================================================
# Build Targets
# =============================================================================

.PHONY: all synth pnr pack prog clean timing stats help check

# Default target: build everything
all: $(BIN) timing

# Create build directory
$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

# =============================================================================
# Synthesis (Yosys)
# =============================================================================

synth: $(JSON)

$(JSON): $(VERILOG_SRCS) $(PCF) | $(BUILD_DIR)
	@echo "=============================================="
	@echo " SYNTHESIS: Yosys"
	@echo "=============================================="
	@echo "$$YOSYS_SCRIPT" > $(BUILD_DIR)/synth.ys
	$(YOSYS) $(YOSYS_FLAGS) -l $(BUILD_DIR)/synth.log -s $(BUILD_DIR)/synth.ys
	@echo "Synthesis complete: $(JSON)"
	@grep -E "Number of|cells:|wires:" $(BUILD_DIR)/synth.log | tail -20

# =============================================================================
# Place and Route (nextpnr-ice40)
# =============================================================================

pnr: $(ASC)

$(ASC): $(JSON) $(PCF) | $(BUILD_DIR)
	@echo "=============================================="
	@echo " PLACE & ROUTE: nextpnr-ice40"
	@echo "=============================================="
	$(NEXTPNR) $(NEXTPNR_FLAGS) \
		--json $(JSON) \
		--pcf $(PCF) \
		--asc $(ASC) \
		--log $(LOG) \
		--report $(BUILD_DIR)/$(PROJECT)_report.json \
		2>&1 | tee $(BUILD_DIR)/pnr_stdout.log
	@echo "Place & Route complete: $(ASC)"
	@echo ""
	@echo "--- Resource Utilization ---"
	@grep -E "ICESTORM_LC|ICESTORM_RAM|SB_IO|SB_GB|SB_DSP" $(LOG) || true
	@echo ""
	@grep -E "Max frequency" $(LOG) || echo "Check $(LOG) for timing"

# =============================================================================
# Bitstream Packing (icepack)
# =============================================================================

pack: $(BIN)

$(BIN): $(ASC) | $(BUILD_DIR)
	@echo "=============================================="
	@echo " BITSTREAM: icepack"
	@echo "=============================================="
	$(ICEPACK) $(ICEPACK_FLAGS) $(ASC) $(BIN)
	@echo "Bitstream generated: $(BIN)"
	@ls -lh $(BIN)

# =============================================================================
# Timing Analysis (icetime)
# =============================================================================

timing: $(RPT)

$(RPT): $(ASC) | $(BUILD_DIR)
	@echo "=============================================="
	@echo " TIMING ANALYSIS: icetime"
	@echo "=============================================="
	$(ICETIME) $(ICETIME_FLAGS) -r $(RPT) $(ASC)
	@echo ""
	@echo "--- Timing Summary ---"
	@grep -E "Total path delay|Max frequency" $(RPT) || cat $(RPT)

# =============================================================================
# Programming (iceprog)
# =============================================================================

prog: $(BIN)
	@echo "=============================================="
	@echo " PROGRAMMING: iceprog"
	@echo "=============================================="
	@echo "Programming iCE40 via FTDI..."
	$(ICEPROG) $(ICEPROG_FLAGS) $(BIN)
	@echo "Programming complete!"

# Program to SPI flash (persistent)
prog-flash: $(BIN)
	@echo "=============================================="
	@echo " FLASH PROGRAMMING: iceprog"
	@echo "=============================================="
	@echo "Programming to SPI flash (persistent)..."
	$(ICEPROG) $(ICEPROG_FLAGS) $(BIN)
	@echo "Flash programming complete!"

# Program to SRAM (volatile, immediate)
prog-sram: $(BIN)
	@echo "=============================================="
	@echo " SRAM PROGRAMMING: iceprog -S"
	@echo "=============================================="
	@echo "Programming to SRAM (volatile, faster for testing)..."
	$(ICEPROG) -S $(BIN)
	@echo "SRAM programming complete!"

# =============================================================================
# Statistics and Reports
# =============================================================================

stats: $(ASC)
	@echo "=============================================="
	@echo " DESIGN STATISTICS"
	@echo "=============================================="
	@echo ""
	@echo "--- iCE40 UP5K Resources ---"
	@echo "Available: 5280 LUTs, 5280 FFs, 120Kb BRAM, 8 DSPs"
	@echo ""
	@grep -E "ICESTORM_LC|ICESTORM_RAM|SB_IO|SB_GB|SB_DSP|SB_PLL|SB_HFOSC" $(LOG) 2>/dev/null || \
		echo "Run 'make pnr' first to generate statistics"
	@echo ""
	@echo "--- Timing ($(DEVICE)) ---"
	@grep -E "Max frequency|Critical path" $(RPT) 2>/dev/null || \
		echo "Run 'make timing' first"

# =============================================================================
# Verification and Checks
# =============================================================================

check: $(JSON)
	@echo "=============================================="
	@echo " DESIGN CHECKS"
	@echo "=============================================="
	@echo "Checking for synthesis warnings..."
	@grep -i "warning" $(BUILD_DIR)/synth.log | head -20 || echo "No warnings found"
	@echo ""
	@echo "Checking for errors..."
	@grep -i "error" $(BUILD_DIR)/synth.log | head -10 || echo "No errors found"

# Lint with Verilator (optional, if installed)
lint:
	@echo "=============================================="
	@echo " LINT CHECK: Verilator"
	@echo "=============================================="
	verilator --lint-only -DICE40 -Wall $(VERILOG_SRCS) 2>&1 | head -50 || \
		echo "Install verilator for lint checking"

# =============================================================================
# Simulation (optional, with Icarus Verilog)
# =============================================================================

SIM_TOP := silens_edge_ice40_tb
SIM_SRCS := $(VERILOG_SRCS) silens_edge_ice40_tb.v

sim: $(SIM_SRCS)
	@echo "=============================================="
	@echo " SIMULATION: Icarus Verilog"
	@echo "=============================================="
	iverilog -DICE40 -DSIMULATION -o $(BUILD_DIR)/$(SIM_TOP).vvp $(SIM_SRCS)
	vvp $(BUILD_DIR)/$(SIM_TOP).vvp
	@echo "Simulation complete"

# View waveforms (requires GTKWave)
waves: sim
	gtkwave $(BUILD_DIR)/$(SIM_TOP).vcd &

# =============================================================================
# Clean
# =============================================================================

clean:
	@echo "Cleaning build artifacts..."
	rm -rf $(BUILD_DIR)
	rm -f *.json *.asc *.bin *.rpt *.log
	@echo "Clean complete"

# =============================================================================
# Help
# =============================================================================

help:
	@echo "=============================================="
	@echo " SiLens Edge iCE40 UP5K Build System"
	@echo "=============================================="
	@echo ""
	@echo "Usage: make [target]"
	@echo ""
	@echo "Build Targets:"
	@echo "  all        - Build everything (default)"
	@echo "  synth      - Run Yosys synthesis"
	@echo "  pnr        - Run nextpnr place & route"
	@echo "  pack       - Generate bitstream with icepack"
	@echo "  timing     - Run timing analysis with icetime"
	@echo ""
	@echo "Programming Targets:"
	@echo "  prog       - Program bitstream via iceprog"
	@echo "  prog-flash - Program to SPI flash (persistent)"
	@echo "  prog-sram  - Program to SRAM (volatile, fast)"
	@echo ""
	@echo "Verification Targets:"
	@echo "  check      - Check synthesis logs for issues"
	@echo "  lint       - Lint with Verilator (if installed)"
	@echo "  sim        - Simulate with Icarus Verilog"
	@echo "  waves      - View simulation waveforms"
	@echo ""
	@echo "Utility Targets:"
	@echo "  stats      - Show resource utilization"
	@echo "  clean      - Remove build artifacts"
	@echo "  help       - Show this help message"
	@echo ""
	@echo "Prerequisites:"
	@echo "  - yosys (synthesis)"
	@echo "  - nextpnr-ice40 (place & route)"
	@echo "  - icestorm (icepack, iceprog, icetime)"
	@echo ""
	@echo "Target Device: Lattice iCE40UP5K-SG48 (UPduino v3.1)"
	@echo ""
