{
    "//": "=======================================================================",
    "//": "Memory Subsystem - Level 3 Subsystem",
    "//": "=======================================================================",
    "//": "DDR3-1066 Memory Controller for external KV cache and weight storage.",
    "//": "Provides unified memory access for LLM, Vision, and Host subsystems.",
    "//": "",
    "//": "Architecture:",
    "//": "- 4-port AXI4 Arbiter (LLM read, LLM write, Vision read, Host DMA)",
    "//": "- DDR3 Controller (command scheduler, refresh, bank management)",
    "//": "- DDR3 PHY (x32 data width, DQS strobe, ODT, read/write leveling)",
    "//": "",
    "//": "DDR3 Specifications:",
    "//": "- Speed: DDR3-1066 (533 MHz clock, 1066 MT/s)",
    "//": "- Width: x32 (4×x8 or 2×x16 chips)",
    "//": "- Capacity: 512MB - 2GB range",
    "//": "- Burst length: 8 (64 bytes per burst)",
    "//": "- Bandwidth: 4.3 GB/s theoretical",
    "//": "",
    "//": "Target: ~50mm² on SKY130 (7100µm × 7100µm)",
    
    "DESIGN_NAME": "memory_subsystem",
    
    "VERILOG_FILES": [
        "dir::src/memory_subsystem.v",
        "dir::src/axi_arbiter.v",
        "dir::src/ddr3_phy.v"
    ],
    
    "//": "=== Clock ===",
    "CLOCK_PORT": "clk_core",
    "CLOCK_PERIOD": 10.0,
    "//": "Core clock: 10ns = 100 MHz",
    "//": "DDR clock: 1.875ns = 533 MHz (handled internally by PHY)",
    
    "//": "=== Die Area ===",
    "//": "Target: ~50mm² = 7100µm × 7100µm",
    "FP_SIZING": "absolute",
    "DIE_AREA": "0 0 7100 7100",
    "CORE_AREA": "50 50 7050 7050",
    
    "//": "=== This is a MACRO, not top-level ===",
    "DESIGN_IS_CORE": false,
    
    "//": "=== Placement ===",
    "PL_TARGET_DENSITY": 0.42,
    "PL_ROUTABILITY_DRIVEN": true,
    "PL_TIME_DRIVEN": true,
    "//": "Lower density for I/O-heavy design with many bidirectional signals",
    
    "//": "=== Synthesis ===",
    "SYNTH_STRATEGY": "AREA 2",
    "SYNTH_MAX_FANOUT": 6,
    "SYNTH_BUFFERING": true,
    "//": "Aggressive area optimization - memory controller is logic-heavy",
    
    "//": "=== CTS ===",
    "CTS_TARGET_SKEW": 100,
    "CTS_SINK_CLUSTERING_SIZE": 25,
    "//": "Tight skew for DDR timing requirements",
    
    "//": "=== Routing ===",
    "GRT_ADJUSTMENT": 0.30,
    "GRT_OVERFLOW_ITERS": 150,
    "//": "More iterations for complex routing with many I/O",
    
    "//": "=== IO Placement ===",
    "//": "DDR3 signals need careful placement for timing",
    "FP_IO_MODE": 1,
    "FP_IO_HLENGTH": 4,
    "FP_IO_VLENGTH": 4,
    
    "//": "=== Signoff ===",
    "RUN_KLAYOUT_XOR": true,
    "RUN_MAGIC_DRC": true,
    "RUN_LVS": true,
    "QUIT_ON_DRC_ERROR": true,
    "QUIT_ON_LVS_ERROR": true,
    "QUIT_ON_TIMING_VIOLATIONS": false,
    "//": "Allow timing violations initially - DDR timing is challenging",
    
    "//": "=== Technology ===",
    "PDK": "sky130A",
    "STD_CELL_LIBRARY": "sky130_fd_sc_hd",
    
    "//": "=== Antenna protection ===",
    "DIODE_INSERTION_STRATEGY": 3,
    
    "//": "=== Outputs for integration at Level 4 (SoC) ===",
    "GENERATE_FINAL_SUMMARY_REPORT": true,
    
    "VERILOG_DEFINES": [
        "SYNTHESIS_SKY130",
        "LEVEL3_SUBSYSTEM",
        "DDR3_1066_MODE"
    ]
}
