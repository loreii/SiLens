    "DESIGN_NAME": "attention_head_edge",
    
    "VERILOG_FILES": [
        "dir::src/attention_head_edge.v"
    ],
    
    "//": "=== Clock ===",
    "CLOCK_PORT": "clk",
    "CLOCK_PERIOD": 5.0,
    "//": "5ns = 200 MHz target frequency (Edge vision requirement)",
    
    "//": "=== Die Area ===",
    "//": "Target: ~1.5mm² = 1225µm × 1225µm",
    "FP_SIZING": "absolute",
    "DIE_AREA": "0 0 1225 1225",
    "CORE_AREA": "25 25 1200 1200",
    
    "//": "=== This is a MACRO, not top-level ===",
    "DESIGN_IS_CORE": false,
    
    "//": "=== Placement ===",
