{
    "//": "=======================================================================",
    "//": "Softmax Approximation Unit - Level 1 Primitive",
    "//": "=======================================================================",
    "//": "Used in attention score normalization (42× across vision and LLM).",
    "//": "Must be DRC clean for hierarchical integration.",
    
    "DESIGN_NAME": "softmax_unit",
    
    "VERILOG_FILES": [
        "dir::src/softmax_unit.v"
    ],
    
    "//": "=== Clock ===",
    "CLOCK_PORT": "clk",
    "CLOCK_PERIOD": 10.0,
    
    "//": "=== Die Area ===",
    "//": "Target: ~0.5mm² = 700µm × 700µm",
    "FP_SIZING": "absolute",
    "DIE_AREA": "0 0 700 700",
    "CORE_AREA": "20 20 680 680",
    
    "DESIGN_IS_CORE": false,
    
    "//": "=== Placement ===",
    "PL_TARGET_DENSITY": 0.50,
    "PL_ROUTABILITY_DRIVEN": true,
    "PL_TIME_DRIVEN": true,
    
    "//": "=== Synthesis ===",
    "SYNTH_STRATEGY": "AREA 2",
    "SYNTH_MAX_FANOUT": 6,
    
    "//": "=== Signoff ===",
    "RUN_KLAYOUT_XOR": true,
    "RUN_MAGIC_DRC": true,
    "QUIT_ON_DRC_ERROR": true,
    
    "//": "=== Technology ===",
    "PDK": "sky130A",
    "STD_CELL_LIBRARY": "sky130_fd_sc_hd",
    
    "DIODE_INSERTION_STRATEGY": 3,
    
    "VERILOG_DEFINES": [
        "SYNTHESIS_SKY130",
        "LEVEL1_MACRO"
    ]
}
