    "//": "SiLU(x) = x * sigmoid(x) via piecewise linear approximation",
    
    "DESIGN_NAME": "silu_unit",
    
    "VERILOG_FILES": [
        "dir::src/silu_unit.v"
    ],
    
    "//": "=== Clock ===",
    "CLOCK_PORT": "clk",
    "CLOCK_PERIOD": 10.0,
    
    "//": "=== Die Area ===",
