{
    "//": "=======================================================================",
    "//": "Ternary MAC Array (64-wide SIMD) - Level 1 Primitive",
    "//": "=======================================================================",
    "//": "This is the core compute primitive. Must be DRC clean and timing closed.",
    "//": "Reused ~2000× across the full SoC.",
    
    "DESIGN_NAME": "ternary_mac_array_64",
    
    "VERILOG_FILES": [
        "dir::src/ternary_mac_array_64.v"
    ],
    
    "//": "=== Clock ===",
    "CLOCK_PORT": "clk",
    "CLOCK_PERIOD": 14.0,
    "//": "14ns = ~71 MHz, relaxed from 100MHz based on synthesis results",
    
    "//": "=== Die Area ===",
    "//": "Target: ~1mm² = 1000µm × 1000µm",
    "FP_SIZING": "absolute",
    "DIE_AREA": "0 0 1000 1000",
    "CORE_AREA": "20 20 980 980",
    
    "//": "=== This is a MACRO, not top-level ===",
    "DESIGN_IS_CORE": false,
    
    "//": "=== Placement ===",
    "PL_TARGET_DENSITY": 0.55,
    "PL_ROUTABILITY_DRIVEN": true,
    "PL_TIME_DRIVEN": true,
    
    "//": "=== Synthesis ===",
    "SYNTH_STRATEGY": "AREA 2",
    "SYNTH_MAX_FANOUT": 6,
    
    "//": "=== CTS ===",
    "CTS_TARGET_SKEW": 100,
    "CTS_SINK_CLUSTERING_SIZE": 20,
    
    "//": "=== Routing ===",
    "GRT_ADJUSTMENT": 0.2,
    
    "//": "=== Signoff - Must be strict for Level 1 ===",
    "RUN_KLAYOUT_XOR": true,
    "RUN_MAGIC_DRC": true,
    "RUN_LVS": true,
    "QUIT_ON_DRC_ERROR": true,
    "QUIT_ON_LVS_ERROR": true,
    "QUIT_ON_TIMING_VIOLATIONS": false,
    "//": "Allow timing violations initially, fix iteratively",
    
    "//": "=== Technology ===",
    "PDK": "sky130A",
    "STD_CELL_LIBRARY": "sky130_fd_sc_hd",
    
    "//": "=== Antenna protection ===",
    "DIODE_INSERTION_STRATEGY": 3,
    "//": "Strategy 3: insert diodes preventively",
    
    "//": "=== Outputs for reuse ===",
    "GENERATE_FINAL_SUMMARY_REPORT": true,
    
    "VERILOG_DEFINES": [
        "SYNTHESIS_SKY130",
        "LEVEL1_MACRO"
    ]
}
