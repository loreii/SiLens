{
    "//": "=======================================================================",
    "//": "Attention Head Block (SMALL) - Level 1 Primitive - Test Variant",
    "//": "=======================================================================",
    "//": "Reduced-size attention head for faster synthesis iteration.",
    "//": "HEAD_DIM: 16 (down from 64), MAX_SEQ: 16 (down from 64)",
    "//": "Estimated IO: ~600-800 pins (down from ~2464)",
    "//": "Target: ~0.64mm² on SKY130 (800µm × 800µm)",
    
    "DESIGN_NAME": "attention_head_small",
    
    "VERILOG_FILES": [
        "dir::src/attention_head_small.v"
    ],
    
    "//": "=== Clock ===",
    "CLOCK_PORT": "clk",
    "CLOCK_PERIOD": 14.0,
    "//": "14ns = ~71 MHz target frequency (same as full design)",
    
    "//": "=== Die Area ===",
    "//": "Target: ~1mm² = 1000µm × 1000µm",
    "FP_SIZING": "absolute",
    "DIE_AREA": "0 0 1000 1000",
    "CORE_AREA": "20 20 980 980",
    
    "//": "=== This is a MACRO, not top-level ===",
    "DESIGN_IS_CORE": false,
    
    "//": "=== Placement ===",
    "//": "Lower density to avoid overflow issues",
    "PL_TARGET_DENSITY": 0.35,
    "PL_ROUTABILITY_DRIVEN": true,
    "PL_TIME_DRIVEN": true,
    
    "//": "=== Synthesis ===",
    "SYNTH_STRATEGY": "AREA 2",
    "SYNTH_MAX_FANOUT": 6,
    "SYNTH_BUFFERING": true,
    
    "//": "=== CTS ===",
    "CTS_TARGET_SKEW": 100,
    "CTS_SINK_CLUSTERING_SIZE": 25,
    
    "//": "=== Routing ===",
    "//": "Less aggressive settings needed for smaller design",
    "GRT_ADJUSTMENT": 0.3,
    "GRT_OVERFLOW_ITERS": 100,
    "GRT_ALLOW_CONGESTION": true,
    
    "//": "=== Signoff - Must be strict for Level 1 ===",
    "RUN_KLAYOUT_XOR": true,
    "RUN_MAGIC_DRC": true,
    "RUN_LVS": true,
    "QUIT_ON_DRC_ERROR": true,
    "QUIT_ON_LVS_ERROR": true,
    "QUIT_ON_TIMING_VIOLATIONS": false,
    "//": "Allow timing violations initially, fix iteratively",
    
    "//": "=== Technology ===",
    "PDK": "sky130A",
    "STD_CELL_LIBRARY": "sky130_fd_sc_hd",
    
    "//": "=== Antenna protection ===",
    "DIODE_INSERTION_STRATEGY": 3,
    "//": "Strategy 3: insert diodes preventively for long routes",
    
    "//": "=== Outputs for reuse ===",
    "GENERATE_FINAL_SUMMARY_REPORT": true,
    
    "VERILOG_DEFINES": [
        "SYNTHESIS_SKY130",
        "LEVEL1_MACRO",
        "SMALL_VARIANT"
    ]
}
